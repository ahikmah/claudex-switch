#!/bin/zsh

set -euo pipefail
setopt null_glob

active_dir="${CLIPROXY_AUTH_DIR:-$HOME/.cli-proxy-api}"
profiles_dir="${CLAUDEX_ACCOUNT_DIR:-$HOME/.cli-proxy-api-accounts}"
state_file="$profiles_dir/active-profile"
config_file="${CLIPROXY_CONFIG:-/opt/homebrew/etc/cliproxyapi.conf}"
service_name="${CLAUDEX_PROXY_SERVICE:-cliproxyapi}"

die() {
  print -u2 -- "Error: $*"
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  claudex-switch list
  claudex-switch current
  claudex-switch use NAME
  claudex-switch add NAME
  claudex-switch rename OLD_NAME NEW_NAME

Commands:
  list       List saved accounts.
  current    Show the active account profile.
  use NAME   Switch to a saved account without a new login.
  add NAME   Save the current account, then log in to a new account.
  rename     Change a saved account profile name.
EOF
}

valid_name() {
  [[ "$1" == <-> ]] && return 1
  [[ "$1" != *[!a-zA-Z0-9._-]* ]]
}

profile_dir() {
  print -r -- "$profiles_dir/$1"
}

codex_files() {
  local dir="$1"
  print -rC1 -- "$dir"/codex-*.json
}

profile_files() {
  local dir="$1"
  local files=("$dir"/codex-*.json)
  print -rC1 -- $files
}

profile_email() {
  local name="$1"
  local current="$(read_active_profile)"
  local dir
  local files

  if [[ "$name" == "$current" ]]; then
    dir="$active_dir"
  else
    dir="$(profile_dir "$name")"
  fi

  files=("$dir"/codex-*.json)
  if (( ${#files} != 1 )); then
    print -r -- "email unavailable"
    return 0
  fi

  jq -r 'if (.email | type) == "string" and .email != "" then .email else "email unavailable" end' "${files[1]}" 2>/dev/null || print -r -- "email unavailable"
}

count_codex_files() {
  local dir="$1"
  local files=("$dir"/codex-*.json)
  print -r -- "${#files}"
}

read_active_profile() {
  if [[ -r "$state_file" ]]; then
    tr -d '\r\n' < "$state_file"
  fi
}

write_active_profile() {
  print -r -- "$1" > "$state_file"
  chmod 600 "$state_file"
}

ensure_dirs() {
  mkdir -p "$active_dir" "$profiles_dir"
  chmod 700 "$active_dir" "$profiles_dir"
}

stop_proxy() {
  brew services stop "$service_name" >/dev/null
}

start_proxy() {
  brew services start "$service_name" >/dev/null
}

save_active_to_profile() {
  local name="$1"
  local target="$(profile_dir "$name")"
  local files=("$active_dir"/codex-*.json)

  (( ${#files} <= 1 )) || die "More than one active Codex credential exists. Remove account rotation first."
  (( ${#files} == 1 )) || die "No active Codex credential exists."

  mkdir -p "$target"
  chmod 700 "$target"
  mv "${files[1]}" "$target/"
}

activate_profile() {
  local name="$1"
  local target="$(profile_dir "$name")"
  local target_files=("$target"/codex-*.json)
  local active_files=("$active_dir"/codex-*.json)
  local current="$(read_active_profile)"

  [[ -d "$target" ]] || die "Unknown account profile: $name"
  (( ${#target_files} == 1 )) || die "Profile '$name' must contain exactly one Codex credential."
  (( ${#active_files} <= 1 )) || die "More than one active Codex credential exists."

  if [[ "$current" == "$name" && ${#active_files} == 1 ]]; then
    print -- "Already active: $name"
    return 0
  fi

  print -- "Stopping CLIProxyAPI..."
  stop_proxy

  local old_profile_dir
  if [[ -n "$current" && -d "$(profile_dir "$current")" && ${#active_files} == 1 ]]; then
    old_profile_dir="$(profile_dir "$current")"
    mv "${active_files[1]}" "$old_profile_dir/"
  elif (( ${#active_files} == 1 )); then
    die "Active credential is not registered. Use 'add NAME' or register it first."
  fi

  mv "${target_files[1]}" "$active_dir/"
  write_active_profile "$name"
  start_proxy
  print -- "Active account: $name"
}

list_accounts() {
  ensure_dirs
  local current="$(read_active_profile)"
  local dirs=("$profiles_dir"/*(/N))
  local dir name count marker
  local active_files=("$active_dir"/codex-*.json)

  if (( ${#dirs} == 0 )); then
    print -- "No saved accounts."
    return 0
  fi

  for dir in $dirs; do
    name="${dir:t}"
    if [[ "$name" == "$current" && ${#active_files} == 1 ]]; then
      count=1
    else
      count="$(count_codex_files "$dir")"
    fi
    marker=" "
    [[ "$name" == "$current" ]] && marker="*"
    print -- "$marker $name ($(profile_email "$name"), $count credential)"
  done
}

add_account() {
  local name="$1"
  local target="$(profile_dir "$name")"
  local current="$(read_active_profile)"
  local active_files=("$active_dir"/codex-*.json)
  local -a new_files restore_files

  valid_name "$name" || die "Use only letters, numbers, dot, underscore, or hyphen in the name."
  [[ ! -e "$target" ]] || die "Account profile already exists: $name"
  (( ${#active_files} <= 1 )) || die "More than one active Codex credential exists."

  ensure_dirs
  mkdir -p "$target"
  chmod 700 "$target"

  if [[ -z "$current" && ${#active_files} == 1 ]]; then
    die "The current active account is not registered. Register it before adding another account."
  fi

  print -- "Stopping CLIProxyAPI..."
  stop_proxy

  if (( ${#active_files} == 1 )); then
    [[ -n "$current" ]] || die "No active profile name is recorded."
    mv "${active_files[1]}" "$(profile_dir "$current")/"
  fi

  print -- "Starting Codex login for profile: $name"
  if ! cliproxyapi --config "$config_file" --codex-login; then
    print -u2 -- "Login failed. Restoring the previous account."
    restore_files=("$(profile_dir "$current")"/codex-*.json)
    (( ${#restore_files} == 1 )) && mv "${restore_files[1]}" "$active_dir/"
    rmdir "$target" 2>/dev/null || true
    start_proxy
    exit 1
  fi

  new_files=("$active_dir"/codex-*.json)
  (( ${#new_files} == 1 )) || die "Login did not create exactly one Codex credential."
  mv "${new_files[1]}" "$target/"
  mv "$target"/codex-*.json "$active_dir/"
  write_active_profile "$name"
  start_proxy
  print -- "Active account: $name"
}

rename_account() {
  local old_name="$1"
  local new_name="$2"
  local old_dir="$(profile_dir "$old_name")"
  local new_dir="$(profile_dir "$new_name")"
  local current="$(read_active_profile)"

  valid_name "$old_name" || die "Invalid old account name."
  valid_name "$new_name" || die "Invalid new account name."
  [[ -d "$old_dir" ]] || die "Unknown account profile: $old_name"
  [[ ! -e "$new_dir" ]] || die "Account profile already exists: $new_name"

  mv "$old_dir" "$new_dir"
  if [[ "$current" == "$old_name" ]]; then
    write_active_profile "$new_name"
  fi
  print -- "Renamed $old_name to $new_name"
}

ensure_dirs

case "${1:-}" in
  list)
    list_accounts
    ;;
  current)
    current="$(read_active_profile)"
    [[ -n "$current" ]] || die "No active account profile is recorded."
    print -- "$current"
    ;;
  use)
    [[ -n "${2:-}" ]] || die "Missing account name."
    valid_name "$2" || die "Invalid account name."
    activate_profile "$2"
    ;;
  add)
    [[ -n "${2:-}" ]] || die "Missing account name."
    add_account "$2"
    ;;
  rename)
    [[ -n "${2:-}" && -n "${3:-}" ]] || die "Usage: claudex-switch rename OLD_NAME NEW_NAME"
    rename_account "$2" "$3"
    ;;
  help|-h|--help|"")
    usage
    ;;
  *)
    usage
    exit 2
    ;;
esac
